<Window x:Class="SHA512HashWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SHA512HashWpf" xmlns:hash="clr-namespace:SHA512HashWpf.Hash" d:DataContext="{d:DesignInstance Type=hash:HashViewModel}"
        mc:Ignorable="d"
        Title="SHA512 Hash Generator" Height="600" Width="1000">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="70*"/>
            <ColumnDefinition Width="30*"/>
        </Grid.ColumnDefinitions>

        <!-- Sekcja główna i wynik (lewa strona) -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="80*"/>
                <RowDefinition Height="20*"/>
            </Grid.RowDefinitions>

            <!-- Sekcja główna (górna) -->
            <Border Grid.Row="0" Padding="20" Background="{StaticResource MainPanelBackgroundBrush}">
                <StackPanel Orientation="Vertical">
                    <Label Content="Dane wejściowe:" FontSize="14" FontWeight="Bold" Margin="0,0,0,10" Foreground="{StaticResource BlackBrush}"/>

                    <TextBox Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" Name="InputTextBox" Height="80" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,15" Padding="10" BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1"/>

                    <Button Content="Generuj" Command="{Binding GenerateCommand}" Height="35" Margin="0,0,0,15" Background="{StaticResource BtnPrimaryBrush}" Foreground="{StaticResource WhiteBrush}" FontSize="14" FontWeight="Bold" Cursor="Hand"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <CheckBox IsChecked="{Binding IsAsmDllChoosen}" Name="UseAsmCheckBox" VerticalAlignment="Center"/>
                        <Label Content="Użyj asemblerowej DLL-ki" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </StackPanel>

                    <Label Content="Wybierz liczbę wątków:" FontSize="12" Margin="0,0,0,5"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <Slider Name="ThreadsSlider" Value="{Binding SelectedNumberOfThreads}" Width="200" Minimum="1" Maximum="{Binding MaximumNumberOfThreads}" VerticalAlignment="Center" Margin="0,0,10,0" TickFrequency="1" IsSnapToTickEnabled="True" />
                        <Label Name="ThreadCountLabel" Content="{Binding SelectedNumberOfThreads}" Width="30" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Command="{Binding HashCommand}" Content="Haszuj!!!" Height="35" Background="{StaticResource BtnSecondaryBrush}" Foreground="{StaticResource WhiteBrush}" FontSize="14" FontWeight="Bold" Cursor="Hand"/>
                </StackPanel>
            </Border>

            <!-- Sekcja wyniku (dolna) -->
            <Border Grid.Row="1" Padding="20" Background="{StaticResource ResultPanelBackgroundBrush}">
                <StackPanel Orientation="Vertical">
                    <Label Content="Wynik:" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Output}" Name="ResultLabel" FontSize="11" Background="{StaticResource WhiteBrush}" Padding="10" BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1" Height="60" TextWrapping="Wrap" IsReadOnly="True"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Sekcja Historia (prawa strona) -->
        <Border Grid.Column="1" Padding="15" Background="{StaticResource HistoryPanelBackgroundBrush}" BorderBrush="{StaticResource HistoryBorderBrush}" BorderThickness="1,0,0,0">
            <StackPanel Orientation="Vertical">
                <Label Content="Historia" FontSize="14" FontWeight="Bold" Margin="0,0,0,15" HorizontalAlignment="Center"/>

                <Border Padding="0,0,0,10">
                    <DataGrid Name="HistoryDataGrid" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Lp" Binding="{Binding Index}" IsReadOnly="True" Width="40"/>
                            <DataGridTextColumn Header="Metoda" Binding="{Binding Method}" IsReadOnly="True" Width="80"/>
                            <DataGridTextColumn Header="Czas" Binding="{Binding Time}" IsReadOnly="True" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
